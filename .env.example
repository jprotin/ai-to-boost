# === Assistant IA local — secrets & config ===
# Copier en .env (gitignoré) et compléter. NE JAMAIS committer .env.

# --- LiteLLM = modèles LOCAUX uniquement (Phase 1) ---
# Claude n'est PAS routé par LiteLLM (cf. ADR 0002) :
#   - Claude à la main (BMAD)  -> Claude Code (forfait Max)
#   - Claude automatisé (n8n)  -> `claude -p` headless / Agent SDK (forfait)
#
# Si un jour tu ajoutes une route Claude au token dans config.yaml (tâche
# programmatique lourde uniquement), mets la clé ICI, dans ce .env confiné au
# conteneur — JAMAIS exportée dans ton shell global (sinon Claude Code la prend
# et facture l'API au lieu du forfait) :
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- LiteLLM gateway (Phase 1) ---
LITELLM_MASTER_KEY=sk-local-change-me
# Endpoint du serveur LM Studio (OpenAI-compatible) vu depuis les conteneurs
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Base de données LiteLLM (clés virtuelles, budgets, logs persistés)
POSTGRES_PASSWORD=change-me
# Reprendre le même mot de passe que POSTGRES_PASSWORD ci-dessus (hôte = litellm-db)
DATABASE_URL=postgresql://litellm:change-me@litellm-db:5432/litellm

# --- faster-whisper (Phase 2) ---
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --- n8n (Phase 3) ---
N8N_ENCRYPTION_KEY=change-me-32-chars-minimum
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Telegram (Phase 4) ---
TELEGRAM_BOT_TOKEN=
# Allowlist : IDs de chat autorisés, séparés par des virgules (sécurité accès distant)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Qdrant (Phase 5) ---
QDRANT_API_KEY=change-me
