# === Assistant IA local — secrets & config ===
# Copier en .env (gitignoré) et compléter. NE JAMAIS committer .env.

# --- LiteLLM = modèles LOCAUX uniquement (Phase 1) ---
# Claude n'est PAS routé par LiteLLM (cf. ADR 0002) :
#   - Claude à la main (BMAD)  -> Claude Code (forfait Max)
#   - Claude automatisé (n8n)  -> `claude -p` headless / Agent SDK (forfait)
#
# Si un jour tu ajoutes une route Claude au token dans config.yaml (tâche
# programmatique lourde uniquement), mets la clé ICI, dans ce .env confiné au
# conteneur — JAMAIS exportée dans ton shell global (sinon Claude Code la prend
# et facture l'API au lieu du forfait) :
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- LiteLLM gateway (Phase 1) ---
LITELLM_MASTER_KEY=sk-local-change-me
# Endpoint du serveur LM Studio (OpenAI-compatible) vu depuis les conteneurs
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Base de données LiteLLM (clés virtuelles, budgets, logs persistés)
POSTGRES_PASSWORD=change-me
# Reprendre le même mot de passe que POSTGRES_PASSWORD ci-dessus (hôte = litellm-db)
DATABASE_URL=postgresql://litellm:change-me@litellm-db:5432/litellm

# --- faster-whisper / speaches (Phase 2) ---
# Config du service whisper définie inline dans compose.yaml (WHISPER__MODEL,
# WHISPER__INFERENCE_DEVICE, WHISPER__COMPUTE_TYPE). Rien à mettre ici.

# --- n8n (Phase 3) ---
# Chiffre les credentials n8n — NE PAS perdre/changer après le 1er run (openssl rand -hex 24).
N8N_ENCRYPTION_KEY=change-me
# Mot de passe du rôle Postgres "n8n" (n8n réutilise l'instance litellm-db).
N8N_DB_PASSWORD=change-me

# --- Bridge claude -p (hôte, forfait Max) ---
# Token Bearer partagé entre le bridge (hôte) et n8n (openssl rand -hex 24).
BRIDGE_TOKEN=change-me
CLAUDE_BRIDGE_PORT=8088
CLAUDE_BRIDGE_MODEL=opus

# --- Worker agentique (Phase 6b, hôte, forfait Max) ---
# claude -p AVEC outils, isolé en git worktree. Token Bearer (openssl rand -hex 24).
AGENT_TOKEN=change-me
AGENT_PORT=8089
AGENT_MODEL=opus
AGENT_TIMEOUT=600
AGENT_MAXTURNS=30
# Repo cible par défaut quand /code ne le précise pas (Phase 6b.2).
AGENT_DEFAULT_REPO=/home/<user>/agent-workspace/sandbox
# Callback n8n appelé en fin de job (retour async vers l'origine).
AGENT_CALLBACK_URL=http://127.0.0.1:5678/webhook/job-callback
# Exiger le marqueur .ai-to-boost/ (projet initialisé via scripts/ai-to-boost-init.sh) — Phase 6b.3b.
AGENT_REQUIRE_MARKER=true
# BMAD commun : installé une fois ici, injecté (symlink) dans chaque worktree — Phase 6b.3c.
# Install : npx bmad-method@latest install --yes --directory <dir> --modules bmm --tools claude-code
AGENT_BMAD_DIR=/home/<user>/agent-workspace/.bmad-shared
# Repo(s) interdit(s) comme cible (défaut = repo ai-to-boost). Séparés par ':'.
# AGENT_FORBID=/datadisk/ai-projects/ai-to-boost

# --- Telegram (Phase 4) ---
TELEGRAM_BOT_TOKEN=
# Allowlist : IDs de chat autorisés, séparés par des virgules (sécurité accès distant)
TELEGRAM_ALLOWED_CHAT_IDS=
# Token Bearer pour l'endpoint /notify du poller (Phase 6b.2, openssl rand -hex 24)
NOTIFY_TOKEN=change-me

# --- Qdrant / RAG (Phase 5) ---
# Qdrant local-only (127.0.0.1) sans clé API en v1.
QDRANT_URL=http://127.0.0.1:6333
RAG_COLLECTION=knowledge
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
