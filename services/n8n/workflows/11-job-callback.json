{
  "id": "jobcallback00001",
  "name": "Phase 6b.2 — job callback (worker → Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-callback",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000001",
      "name": "Webhook job-callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "job-callback"
    },
    {
      "parameters": {
        "jsCode": "// Reçoit l'état final d'un job du worker, formate un message pour l'origine.\nconst j = $json.body ?? $json;\nconst id = j.job_id || '?';\nlet text;\nif (j.status === 'done') {\n  const summary = (j.summary || '').slice(0, 1500);\n  const diff = j.diff_stat || '(aucun changement)';\n  text = `✅ Tâche ${id} terminée\\nBranche : ${j.branch}\\n${diff}\\n\\n${summary}`;\n} else {\n  text = `❌ Tâche ${id} échouée\\n${j.error || 'erreur inconnue'}`;\n}\nreturn [{ json: { chat_id: j.return_target, text, has_target: !!j.return_target } }];"
      },
      "id": "b0000000-0000-0000-0000-000000000002",
      "name": "Formate message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.has_target }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000003",
      "name": "A une origine ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://telegram-poller:8090/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text }) }}",
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000004",
      "name": "Notifier (poller)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "notifytoken00001",
          "name": "Poller notify token"
        }
      }
    }
  ],
  "connections": {
    "Webhook job-callback": {
      "main": [[{ "node": "Formate message", "type": "main", "index": 0 }]]
    },
    "Formate message": {
      "main": [[{ "node": "A une origine ?", "type": "main", "index": 0 }]]
    },
    "A une origine ?": {
      "main": [
        [{ "node": "Notifier (poller)", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
