{
  "id": "jobcallback00001",
  "name": "Phase 6b.2 — job callback (worker → Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "job-callback",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000001",
      "name": "Webhook job-callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "job-callback"
    },
    {
      "parameters": {
        "jsCode": "// Formate l'état final d'un JOB ou d'un PIPELINE pour l'origine (Telegram).\nconst j = $json.body ?? $json;\nlet text;\nif (j.kind === 'pipeline') {\n  const pid = j.pipeline_id || '?';\n  if (j.status === 'awaiting_approval') {\n    text = `⏸ Jalon « ${j.awaiting || j.phase} » — pipeline ${pid}\\n${j.last_artifact || ''}\\n→ /approve · /revise <retour> · /stop`;\n  } else if (j.status === 'done') {\n    text = `✅ Pipeline ${pid} terminé\\nBranche : ${j.branch}\\n${j.diff_stat || ''}`;\n  } else if (j.status === 'error') {\n    text = `❌ Pipeline ${pid} en erreur\\n${j.error || 'erreur inconnue'}`;\n  } else if (j.status === 'stopped') {\n    text = `⏹ Pipeline ${pid} arrêté`;\n  } else {\n    return []; // running / accepted : pas de notification (anti-spam)\n  }\n  return [{ json: { chat_id: j.return_target, text, has_target: !!j.return_target } }];\n}\n// --- Job one-shot (comportement d'origine) ---\nconst id = j.job_id || '?';\nif (j.status === 'done') {\n  const summary = (j.summary || '').slice(0, 1500);\n  const diff = j.diff_stat || '(aucun changement)';\n  text = `✅ Tâche ${id} terminée\\nBranche : ${j.branch}\\n${diff}\\n\\n${summary}`;\n} else {\n  text = `❌ Tâche ${id} échouée\\n${j.error || 'erreur inconnue'}`;\n}\nreturn [{ json: { chat_id: j.return_target, text, has_target: !!j.return_target } }];\n"
      },
      "id": "b0000000-0000-0000-0000-000000000002",
      "name": "Formate message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.has_target }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000003",
      "name": "A une origine ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://telegram-poller:8090/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text }) }}",
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000004",
      "name": "Notifier (poller)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "notifytoken00001",
          "name": "Poller notify token"
        }
      }
    }
  ],
  "connections": {
    "Webhook job-callback": {
      "main": [
        [
          {
            "node": "Formate message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formate message": {
      "main": [
        [
          {
            "node": "A une origine ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A une origine ?": {
      "main": [
        [
          {
            "node": "Notifier (poller)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
