    {
      "parameters": {
        "jsCode": "// Normalise toutes les entrées vers {command, payload, return_target, source}.\nconst b = $json.body ?? $json;\nconst text = (b.text || '').trim();\nconst return_target = b.return_target ?? b.chat_id ?? null;\nconst source = b.source ?? (b.chat_id ? 'telegram' : 'api');\n\nlet command = 'chat';\nlet payload = text;\nconst m = text.match(/^\\/(\\w+)\\s*([\\s\\S]*)$/);\nif (m) {\n  const c = m[1].toLowerCase();\n  if (c === 'chat' || c === 'claude' || c === 'code' || c === 'build') {\n    command = (c === 'build') ? 'code' : c;\n    payload = m[2].trim();\n  }\n}\nreturn [{ json: { command, payload, return_target, source } }];"
      },
      "id": "a0000000-0000-0000-0000-000000000002",
      "name": "Normalisation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 320]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "claude",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "claude"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "code",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "code"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "chat" }
      },
      "id": "a0000000-0000-0000-0000-000000000003",
