# Secrets web-app (ADR 0005). Copier en webui.env (non versionné) et renseigner.
# Secret de session Auth.js : openssl rand -hex 32
AUTH_SECRET=change-me
WEBUI_USER=admin
# Hash bcrypt : cd services/webui && node -e "console.log(require('bcryptjs').hashSync('VOTRE_MDP',10))"
WEBUI_PASSWORD_HASH=change-me
