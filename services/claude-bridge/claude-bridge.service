# systemd user unit — bridge claude -p pour n8n
# Install :
#   mkdir -p ~/.config/systemd/user
#   cp services/claude-bridge/claude-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-bridge
#   loginctl enable-linger "$USER"   # démarrage au boot sans session ouverte
[Unit]
Description=Claude bridge (claude -p HTTP wrapper pour n8n)
After=network-online.target

[Service]
Type=simple
# Variables : BRIDGE_TOKEN, CLAUDE_BRIDGE_* (cf. .env du projet)
EnvironmentFile=/datadisk/ai-projects/ai-to-boost/.env
# PATH minimal + ~/.local/bin pour le binaire claude (natif)
Environment=PATH=/home/jprotin/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /datadisk/ai-projects/ai-to-boost/services/claude-bridge/claude_bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
